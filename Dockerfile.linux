# Builds the Linux AirThrow binary. PyInstaller can't cross-compile, so we use
# a Linux container to produce the Linux executable from Windows/macOS/Linux.
#
#   docker build -f Dockerfile.linux -t airthrow-linux .
#   docker run --rm -v "${PWD}/dist:/out" airthrow-linux   # copies binary to ./dist
#
# Python 3.12 is used here (broad manylinux wheel availability for mediapipe).
FROM python:3.12-slim

# Runtime libs OpenCV/mediapipe need present at BUILD time for bundling.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pyinstaller

COPY . .
RUN pyinstaller --clean -y airthrow.spec

# On `docker run` with -v ./dist:/out, drop the built binary into the host.
CMD ["sh", "-c", "cp -v dist/airthrow /out/airthrow && echo 'Linux binary -> ./dist/airthrow'"]
